# URL del servicio de formularios (p. ej. Formspree). Se publica en el cliente.
NEXT_PUBLIC_FORM_ENDPOINT=

# Asistente del chat (solo servidor, nunca con prefijo NEXT_PUBLIC).
# Clave de la API de IA. Si está vacía, el chat usa respuestas de ejemplo.
AI_API_KEY=
# Modelo a usar. Si está vacío se usa claude-haiku-5-5.
AI_MODEL=

# Voz opcional de Mullis (ElevenLabs). La clave y la voz son SOLO de servidor.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# "1" muestra el botón de voz y habilita /api/mullis-voice. Se publica en el cliente.
NEXT_PUBLIC_MULLIS_VOICE=
